      "text": "Postgres: saved_places\nreviews / routes / users",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Postgres: saved_places\nreviews / routes / users",
      "lineHeight": 1.25,
      "baseline": 34
    },
    {
      "id": "0XJfRE6CdkDep3NeO4FW",
      "type": "text",
      "x": 1936,
      "y": 909.2,
      "width": 252,
      "height": 131,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 84958839,
      "version": 1,
      "versionNonce": 1452907385,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1755000000000,
      "link": null,
      "locked": false,
      "text": "Written directly by client\n(no Edge Function, free)\n\nReview or route submitted for\na place -> marks that place's\nplace_cache row stale\n(invalidation loop, see arrow)",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Written directly by client\n(no Edge Function, free)\n\nReview or route submitted for\na place -> marks that place's\nplace_cache row stale\n(invalidation loop, see arrow)",
      "lineHeight": 1.25,
      "baseline": 105
    },
