    {
      "id": "xXBIgxG8W1xgRIDCDLza",
      "type": "text",
      "x": 1756,
      "y": 540.8,
      "width": 268,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
