      "roundness": null,
      "seed": 187668383,
      "version": 1,
      "versionNonce": 1366075329,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1755000000000,
      "link": null,
      "locked": false,
      "text": "Goal = cut repeat-view latency\nonly \u2014 NOT offline-first\n(confirmed with team)\n\nSimple in-memory / SQLite\nkeyed by place ID\n\nNo sync or conflict logic needed",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Goal = cut repeat-view latency\nonly \u2014 NOT offline-first\n(confirmed with team)\n\nSimple in-memory / SQLite\nkeyed by place ID\n\nNo sync or conflict logic needed",
      "lineHeight": 1.25,
      "baseline": 120
    },
