    {
      "id": "OEil16c4Ln2qD3nwGOtG",
      "type": "text",
      "x": 80,
      "y": 1520,
      "width": 620,
      "height": 50,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
