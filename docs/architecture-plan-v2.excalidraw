      "boundElements": [],
      "updated": 1755200000000,
      "link": null,
      "locked": false,
      "text": "1. synthesized fresh?\n   return, skip Apify\n2. raw only? return\n   for on-device synth\n3. nothing cached?\n   call Apify, cache raw\n4. client writes synth\n   result back for all",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. synthesized fresh?\n   return, skip Apify\n2. raw only? return\n   for on-device synth\n3. nothing cached?\n   call Apify, cache raw\n4. client writes synth\n   result back for all",
      "lineHeight": 1.3,
