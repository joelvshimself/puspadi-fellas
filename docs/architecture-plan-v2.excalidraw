      "boundElements": [],
      "updated": 1755300000000,
      "link": null,
      "locked": false,
      "text": "1. place_cache fresh (<90d)?\n   return + live grade\n2. stale/missing? call Google\n   Places (Text/Details, Pro\n   tier, accessibilityOptions)\n3. best-effort OSM/Overpass\n   enrich (never blocks)\n4. upsert place_cache +\n   accessibility_signals",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. place_cache fresh (<90d)?\n   return + live grade\n2. stale/missing? call Google\n   Places (Text/Details, Pro\n   tier, accessibilityOptions)\n3. best-effort OSM/Overpass\n   enrich (never blocks)\n4. upsert place_cache +\n   accessibility_signals",
      "lineHeight": 1.3,
      "baseline": 112
    },
