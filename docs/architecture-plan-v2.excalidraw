    {
      "id": "SRxmehxa4kJJKaZBPE2K",
      "type": "text",
      "x": 80,
      "y": 1550,
      "width": 620,
      "height": 50,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1275349551,
      "version": 1,
      "versionNonce": 1191256887,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1755300000000,
      "link": null,
      "locked": false,
      "text": "Limitation: a place is discoverable only once someone has\nsearched it via Flow A-left. Cold-start gap in unsearched\nareas is expected v1 behavior, not a bug.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Limitation: a place is discoverable only once someone has\nsearched it via Flow A-left. Cold-start gap in unsearched\nareas is expected v1 behavior, not a bug.",
      "lineHeight": 1.3,
      "baseline": 40
    },
    {
      "id": "3UjxNz452SRzHwXjEwbi",
      "type": "text",
      "x": 80,
      "y": 1620,
      "width": 620,
      "height": 50,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 968325763,
      "version": 1,
      "versionNonce": 2017089772,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1755300000000,
      "link": null,
      "locked": false,
      "text": "Results here show the live accessibility_grade() computed\nfrom the shared signal ledger below, and, when one exists,\nrender that venue's self-hosted IMDF archive (Flow C) via MapKit.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Results here show the live accessibility_grade() computed\nfrom the shared signal ledger below, and, when one exists,\nrender that venue's self-hosted IMDF archive (Flow C) via MapKit.",
      "lineHeight": 1.3,
      "baseline": 40
    },
