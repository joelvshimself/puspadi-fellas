      "isDeleted": false,
      "boundElements": [],
      "updated": 1755300000000,
      "link": null,
      "locked": false,
      "text": "OpenStreetMap (free, keyless) is the required primary accessibility source; Google Places is optional secondary enrichment. MapKit handles search on-device. Three lanes per owner, plus a shared signal ledger both Flow A and Flow C feed.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "OpenStreetMap (free, keyless) is the required primary accessibility source; Google Places is optional secondary enrichment. MapKit handles search on-device. Three lanes per owner, plus a shared signal ledger both Flow A and Flow C feed.",
      "lineHeight": 1.3,
      "baseline": 15
    },
