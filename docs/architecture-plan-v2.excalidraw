    },
    {
      "id": "Y2oOdGclhewnouB2ebky",
      "type": "text",
      "x": 1576,
      "y": 2088,
      "width": 633,
      "height": 84,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 152172472,
      "version": 1,
      "versionNonce": 899684854,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1755300000000,
      "link": null,
      "locked": false,
      "text": "Rendering a self-hosted IMDF archive (above) needs NO Apple approval \u2014 any app can\nauthor and render its own IMDF-formatted GeoJSON. Only two things stay gated to Apple's\nIndoor Maps Program: the true floor-accurate \"blue dot\" (CLLocation) used during\nrecording above, and being shown inside Apple Maps itself. Most target venues won't\nhave either \u2014 hence the CoreMotion fallback for positioning while recording.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Rendering a self-hosted IMDF archive (above) needs NO Apple approval \u2014 any app can\nauthor and render its own IMDF-formatted GeoJSON. Only two things stay gated to Apple's\nIndoor Maps Program: the true floor-accurate \"blue dot\" (CLLocation) used during\nrecording above, and being shown inside Apple Maps itself. Most target venues won't\nhave either \u2014 hence the CoreMotion fallback for positioning while recording.",
      "lineHeight": 1.3,
      "baseline": 67
    },
