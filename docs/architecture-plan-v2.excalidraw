      "versionNonce": 1176321420,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1755300000000,
      "link": null,
      "locked": false,
      "text": "Confidence-weighted, time-decayed blend\n(180-day half-life, tunable). Sums each\ncandidate value's decayed weight per\nfeature; highest wins. NOT stored \u2014 decay\ndepends on 'now', recomputed every read.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Confidence-weighted, time-decayed blend\n(180-day half-life, tunable). Sums each\ncandidate value's decayed weight per\nfeature; highest wins. NOT stored \u2014 decay\ndepends on 'now', recomputed every read.",
      "lineHeight": 1.3,
      "baseline": 67
    },
