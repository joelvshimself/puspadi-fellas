    {
      "id": "xmRknBspvzc6OCsf8T0F",
      "type": "text",
      "x": 92,
      "y": 831.0,
      "width": 235,
      "height": 156,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1848562758,
      "version": 1,
      "versionNonce": 1900612423,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1755300000000,
      "link": null,
      "locked": false,
      "text": "1. derive place_id from lat/lng\n   (our own key, not a provider ID)\n2. place_cache fresh (<90d)?\n   return + live grade\n3. ALWAYS query OSM/Overpass\n   (free, keyless, primary)\n4. IF key configured: also try\n   Google (optional, secondary)\n5. upsert place_cache +\n   accessibility_signals",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. derive place_id from lat/lng\n   (our own key, not a provider ID)\n2. place_cache fresh (<90d)?\n   return + live grade\n3. ALWAYS query OSM/Overpass\n   (free, keyless, primary)\n4. IF key configured: also try\n   Google (optional, secondary)\n5. upsert place_cache +\n   accessibility_signals",
      "lineHeight": 1.3,
      "baseline": 124
    },
