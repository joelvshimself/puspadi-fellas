    {
      "id": "awIt7QEpDt5uOehxcyaJ",
      "type": "text",
      "x": 80,
      "y": 1590,
      "width": 620,
      "height": 50,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1580225828,
      "version": 1,
      "versionNonce": 216060993,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1755300000000,
      "link": null,
      "locked": false,
      "text": "Limitation: a place is discoverable only once someone has\nsearched it via Flow A-left. Cold-start gap in unsearched\nareas is expected v1 behavior, not a bug.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Limitation: a place is discoverable only once someone has\nsearched it via Flow A-left. Cold-start gap in unsearched\nareas is expected v1 behavior, not a bug.",
      "lineHeight": 1.3,
      "baseline": 40
    },
    {
      "id": "BL05pmBq9DAnr18GXKzE",
      "type": "text",
      "x": 80,
      "y": 1660,
      "width": 620,
      "height": 50,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1840621487,
      "version": 1,
      "versionNonce": 1319497070,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1755300000000,
      "link": null,
      "locked": false,
      "text": "Results here show the live accessibility_grade() computed\nfrom the shared signal ledger below, and, when one exists,\nrender that venue's self-hosted IMDF archive (Flow C) via MapKit.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Results here show the live accessibility_grade() computed\nfrom the shared signal ledger below, and, when one exists,\nrender that venue's self-hosted IMDF archive (Flow C) via MapKit.",
      "lineHeight": 1.3,
      "baseline": 40
    },
