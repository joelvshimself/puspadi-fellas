      "roundness": null,
      "seed": 1447786069,
      "version": 1,
      "versionNonce": 528009857,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1755200000000,
      "link": null,
      "locked": false,
      "text": "Limitation: a place is discoverable only once someone has\nsearched it via Flow A-left. Cold-start gap in unsearched\nareas is expected v1 behavior, not a bug.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Limitation: a place is discoverable only once someone has\nsearched it via Flow A-left. Cold-start gap in unsearched\nareas is expected v1 behavior, not a bug.",
      "lineHeight": 1.3,
      "baseline": 40
    },
    {
      "id": "3R1gRgKXi0Wz2qZKlXhj",
      "type": "text",
      "x": 80,
      "y": 1590,
      "width": 620,
      "height": 33,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1854048415,
      "version": 1,
      "versionNonce": 1780225564,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1755200000000,
      "link": null,
      "locked": false,
      "text": "Results here also render that venue's self-hosted IMDF\narchive (built in Flow C) via MapKit, when one exists.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Results here also render that venue's self-hosted IMDF\narchive (built in Flow C) via MapKit, when one exists.",
      "lineHeight": 1.3,
      "baseline": 27
    },
