      "updated": 1755300000000,
      "link": null,
      "locked": false,
      "text": "place_id, feature (entrance/parking/\nrestroom/seating), value (yes/no/\nlimited/unknown), source (google/osm/\nreview/confirmation), user_id, weight,\ncreated_at\n\nOne row per (place, feature, source, user) \u2014\na repeat signal updates, never stacks.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "place_id, feature (entrance/parking/\nrestroom/seating), value (yes/no/\nlimited/unknown), source (google/osm/\nreview/confirmation), user_id, weight,\ncreated_at\n\nOne row per (place, feature, source, user) \u2014\na repeat signal updates, never stacks.",
      "lineHeight": 1.3,
      "baseline": 108
    },
