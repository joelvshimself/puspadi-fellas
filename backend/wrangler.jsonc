{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rollspot-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "API_BASE_URL": "https://api.rollspot.app",
    "APPLE_CLIENT_ID": "com.puspadifellas.app",
    "GOOGLE_IOS_CLIENT_ID": "replace-with-google-ios-client-id",
    "EMAIL_FROM": "Rollspot <hello@rollspot.app>"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rollspot",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "rollspot-media"
    }
  ]
}
